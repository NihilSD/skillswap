# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Safe to expose to the browser (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-or-hosted-anon-key

# !! SERVER ONLY — NEVER import this in a file that ships to the browser. !!
# This key BYPASSES Row Level Security entirely. It is only used from trusted
# server code (the Stripe webhook route in Stage 8). It must never appear in a
# Client Component, in NEXT_PUBLIC_* form, or in anything sent to a browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Stripe (Stage 8)
# ---------------------------------------------------------------------------
# Server-only secret key. Test mode keys start with sk_test_.
STRIPE_SECRET_KEY=sk_test_...

# The recurring Price ID for the Premium plan (Products -> Premium -> Pricing).
STRIPE_PREMIUM_PRICE_ID=price_...

# Signing secret for the webhook endpoint. `stripe listen` prints a whsec_...
# for local use; the Stripe dashboard gives you a different one per deployed
# endpoint. They are not interchangeable.
STRIPE_WEBHOOK_SECRET=whsec_...
